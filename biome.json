{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
  "files": {
    "includes": [
      ".tau/*.json",
      ".zed/*.json",
      "src/**/*.{ts,js}",
      "test/**/*.js",
      "scripts/**/*.js",
      "*.{ts,json,md}",
      "!**/node_modules/**/*",
      "!dist/**/*",
      "!references/repos/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      },
      "correctness": {
        "noUnusedVariables": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}
