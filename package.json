{
  "name": "@markusylisiurunen/tau",
  "version": "0.2.0-alpha.3",
  "type": "module",
  "bin": {
    "tau": "./dist/main.js"
  },
  "files": [
    "dist/",
    "patches/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check --write . && tsc -p tsconfig.json --noEmit",
    "precheck": "node scripts/generate-version.js",
    "prebuild": "node scripts/generate-version.js",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run",
    "postinstall": "patch-package"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "0.47.0",
    "@mariozechner/pi-tui": "0.47.0",
    "@sinclair/typebox": "^0.34.47",
    "chalk": "^5.6.2",
    "patch-package": "^8.0.1",
    "strip-ansi": "^7.1.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
