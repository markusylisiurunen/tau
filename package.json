{
  "name": "@markusylisiurunen/tau",
  "version": "0.2.81",
  "type": "module",
  "bin": {
    "tau": "./dist/main.js"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "build": "(cd src/diff_tool/app && npm run build) && tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-starter.js && node scripts/copy-static-prompts.js && node scripts/copy-diff-tool-app.js && find dist -name '*.d.ts' ! -path 'dist/sdk/*' -delete",
    "check": "prettier -w .tau/**/*.md docs/**/*.md src/core/static/**/*.md starter/**/*.md *.md && biome check --write . && tsc -p tsconfig.json --noEmit && (cd src/diff_tool/app && npm run check)",
    "precheck": "node scripts/generate-version.js && node scripts/generate-themes.js",
    "prebuild": "node scripts/generate-version.js && node scripts/generate-themes.js",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.58.3",
    "@mariozechner/pi-tui": "^0.58.3",
    "@sinclair/typebox": "^0.34.48",
    "chalk": "^5.6.2",
    "file-type": "^21.3.2",
    "sharp": "^0.34.5",
    "strip-ansi": "^7.2.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^25.5.0",
    "colorjs.io": "^0.6.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
