{
  "name": "@markusylisiurunen/tau",
  "version": "0.2.26",
  "type": "module",
  "bin": {
    "tau": "./dist/main.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "prettier -w .tau/**/*.md *.md && biome check --write . && tsc -p tsconfig.json --noEmit",
    "precheck": "node scripts/generate-version.js && node scripts/generate-themes.js",
    "prebuild": "node scripts/generate-version.js && node scripts/generate-themes.js",
    "start": "node dist/main.js",
    "test": "npm run build && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.52.9",
    "@mariozechner/pi-tui": "^0.52.9",
    "@sinclair/typebox": "^0.34.48",
    "chalk": "^5.6.2",
    "file-type": "^21.3.0",
    "strip-ansi": "^7.1.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^24.10.12",
    "colorjs.io": "^0.6.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
