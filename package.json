{
  "name": "@markusylisiurunen/tau",
  "version": "0.1.10",
  "type": "module",
  "bin": {
    "tau": "./dist/main.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "biome check --write . && tsc -p tsconfig.json --noEmit",
    "fmt": "biome format --write .",
    "lint": "biome lint ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.22.2",
    "@mariozechner/pi-tui": "^0.22.2",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.9",
    "@types/node": "^24.10.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
