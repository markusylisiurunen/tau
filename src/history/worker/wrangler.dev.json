{
  "name": "tau-history-dev",
  "main": "index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tau-history-dev",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "API_KEY": "tau-history-dev-api-key",
    "VIEWER_PASSWORD": "tau-history-dev-password"
  }
}
